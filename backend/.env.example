# ========================================
# DATABASE CONFIGURATION
# ========================================
# URL principal usada por la API, apuntando al pooler transaccional (Supavisor). Ej: puerto 6543
# DATABASE_URL=postgresql+psycopg://usuario:password@host:6543/db

# URL directa usada exclusivamente por Alembic para ejecutar migraciones. Ej: puerto 5432
# ALEMBIC_DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/db

# ========================================
# SUPABASE & AUTH
# ========================================
# URL de tu proyecto de Supabase
# SUPABASE_URL=https://xyz.supabase.co

# Los tokens de usuario se verifican contra el JWKS publico de Supabase,
# asi que no hace falta ningun secreto JWT compartido.

# ========================================
# ATENCION: REGLA DE SEGURIDAD
# ========================================
# SUPABASE_SERVICE_KEY es la clave service_role de Supabase. Con ella el
# backend entra a la base saltando RLS. Es opcional.
# JAMAS puede llegar al cliente movil: no va en la app, ni en variables
# EXPO_PUBLIC_, ni en ninguna respuesta de la API. Solo vive en el servidor.
# SUPABASE_SERVICE_KEY=your_service_role_key_here

# ========================================
# POLITICAS DE PEDIDO (D5)
# ========================================
# Todas opcionales. Sin valor, rige el defecto de src/core/config.py.
# Porcentajes en base 100, montos en colones con dos decimales.
# Rango del anticipo que elige el artista, y el que se usa si no elige
# ANTICIPO_PORCENTAJE_MINIMO=30
# ANTICIPO_PORCENTAJE_MAXIMO=50
# ANTICIPO_PORCENTAJE_DEFECTO=50
# Dias para abrir una disputa despues de la entrega o de la fecha del evento
# DIAS_VENTANA_DISPUTA=7
# Cancelacion de evento por el cliente: reembolso total con mas de estos dias
# de anticipacion, parcial desde estos dias inclusive, y el porcentaje parcial
# CANCELACION_EVENTO_DIAS_TOTAL=30
# CANCELACION_EVENTO_DIAS_PARCIAL=7
# CANCELACION_EVENTO_PORCENTAJE_PARCIAL=50
# MONTO_MINIMO_PEDIDO=2500.00
# Tarifa de servicio por plan. Se congela en cada pedido al crearlo.
# TARIFA_TALLER_PORCENTAJE=8
# TARIFA_ESTUDIO_PORCENTAJE=5
# Dias que se supone que dura una autorizacion cuando la pasarela no
# informa el vencimiento (D9). Minimo 1.
# DIAS_VIGENCIA_AUTORIZACION_SUPUESTA=5

# ========================================
# CATALOGO Y PLANES
# ========================================
# Limites del plan Taller (D11). Estudio no tiene limite. Bajar de plan nunca
# oculta ni borra nada: solo impide crear o activar otro.
# Servicios activos a la vez en Taller
# LIMITE_SERVICIOS_TALLER=2
# Obras disponibles a la vez en Taller. La galeria en exhibicion no se limita.
# LIMITE_OBRAS_DISPONIBLES_TALLER=5
# Imagenes por obra, en cualquier plan
# MEDIOS_POR_OBRA_MAXIMO=10
# Imagenes por publicacion del feed. Una publicacion puede no tener ninguna.
# MEDIOS_POR_PUBLICACION_MAXIMO=10
# Paginacion por cursor de los listados
# PAGINA_TAMANO_DEFECTO=20
# PAGINA_TAMANO_MAXIMO=50

# ========================================
# FEED
# ========================================
# Explorar reserva una de cada N posiciones para nuevos talentos. Minimo 2.
# EXPLORAR_CADA_N=5
# Un artista con menos seguidores que esto cuenta como nuevo talento
# NUEVO_TALENTO_MAX_SEGUIDORES=50

# ========================================
# CONSULTAS
# ========================================
# Una cuenta con menos de estos dias es reciente. Minimo 1.
# DIAS_CUENTA_RECIENTE=7
# Consultas que una cuenta reciente puede abrir cada 24 horas. Minimo 1.
# CONSULTAS_POR_DIA_CUENTA_RECIENTE=5

# ========================================
# PASARELA DE PAGOS
# ========================================
# Que adaptador usa el backend. Por defecto "falsa": en memoria, sin dinero
# real, para pruebas y la demo. Valores validos: falsa, onvo
# PASARELA=falsa
# A donde vuelve la app despues de autenticarse en el banco (3DS). Si ONVO no
# acepta el esquema propio, se cambia por una pagina https.
# URL_RETORNO_PAGO=artistica://pago

# Solo con PASARELA=onvo. Secretos de servidor: jamas llegan al cliente movil.
# Clave secreta de la cuenta principal del marketplace. Obligatoria con onvo.
# ONVO_API_KEY=onvo_test_secret_key_...
# Opcional. Sin valor rige https://api.onvopay.com
# ONVO_BASE_URL=
# Secreto del webhook que muestra el Dashboard de ONVO. Sin el, no se acepta
# ningun webhook.
# ONVO_WEBHOOK_SECRET=webhook_secret_...
# Segundos de espera por solicitud
# ONVO_TIMEOUT_SEGUNDOS=15

# ========================================
# ALMACENAMIENTO DE MEDIOS
# ========================================
# Que adaptador usa el backend. Por defecto "falso": en memoria, para pruebas
# y la demo. Valores validos: falso, supabase
# "supabase" usa SUPABASE_URL y SUPABASE_SERVICE_KEY (obligatoria).
# "falso" no arranca con ENVIRONMENT=production.
# ALMACENAMIENTO=falso
# Segundos de espera por solicitud a Storage
# ALMACENAMIENTO_TIMEOUT_SEGUNDOS=15
# Bucket publico de la galeria. Se prepara con: python -m src.storage.supabase
# BUCKET_MEDIOS=medios
# Tamano maximo de una imagen en bytes (5 MB)
# MEDIO_TAMANO_MAXIMO_BYTES=5242880
# Subidas sin confirmar que puede tener un artista a la vez
# MEDIOS_PENDIENTES_MAXIMOS=20

# ========================================
# GENERAL
# ========================================
# production o prod activan las reglas de produccion: rechazan los
# adaptadores falsos y ESTUDIO_AUTOSERVICIO. La demo usa ENVIRONMENT=demo.
# ENVIRONMENT=dev
# SENTRY_DSN=
# Fraccion de trazas que se mandan a Sentry, entre 0 y 1. Sin DSN no se usa.
# Los errores nunca llevan datos personales ni variables locales.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Procesos de uvicorn. Mayor que 1 no carga con un adaptador falso.
# WORKERS=1
# Pasarse a Estudio sin cobro. Solo demo: tiene que ser false en produccion.
# ESTUDIO_AUTOSERVICIO=true
# Solo docker compose: puerto del host donde se publica la base
# DB_PUERTO_LOCAL=5432
